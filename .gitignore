# toolchain + checkout (fetched by scripts/, never committed). No trailing
# slash: locally ./chromium is often a symlink to a build disk, and "/chromium/"
# only matches directories — that is how the link once ended up in git.
/chromium
/.cache/
/.dev-profile/

# local-only monitoring dashboard (personal, stays off git)
/monitor/

# scratch build logs (local, reproducible from scripts/build.sh)
/.buildlogs/

.DS_Store
node_modules

# Lokale Test-Builds (macOS/Windows/Linux) — nie committen
.Deploy/
