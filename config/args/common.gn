# browse — shared GN args for all platforms.
# NOTE: arg names drift between Chromium milestones. This set targets the pinned
# version in chromium_version.txt; run `gn args out/Release --list` after every
# version bump and fix what moved.

is_official_build = true
is_debug = false
symbol_level = 1
blink_symbol_level = 0

# PGO braucht heruntergeladene Profile (gclient custom_var
# checkout_pgo_profiles + runhooks). Für Dev-Builds aus; für Release-Builds
# aktivieren, sobald die Profile im Checkout liegen.
chrome_pgo_phase = 0

# No Google service wiring: without API keys the browser cannot talk to
# sync/translate/etc. even by accident. browse ships its own sync later.
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# Telemetry / phone-home surfaces off at compile time where possible.
# (enable_nacl entfernt: NaCl existiert in M152 nicht mehr, gn ignoriert es)
enable_reporting = false
enable_remoting = false
enable_hangout_services_extension = false

# Full media support: streaming sites should not feel broken.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Widevine ohne Lizenzvertrag: browse liefert KEIN CDM mit (bundle=false),
# registriert aber die Widevine-Komponente im Component Updater. Der Browser
# holt das CDM beim ersten Start direkt von Googles Update-Server — wie die
# Chromium-Pakete von Arch/openSUSE/Fedora. Funktioniert unter Linux, unter
# macOS je nach CDM-Version (VMP-Prüfung), unter Windows NICHT (VMP-Signatur
# nur mit Lizenz). Siehe docs/ROADMAP.md, Patch 009.
enable_widevine = true
bundle_widevine_cdm = false
