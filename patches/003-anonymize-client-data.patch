From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Batman <batman@Batman.local>
Date: Sun, 16 Aug 2026 00:48:13 +0200
Subject: [PATCH] browse patch 003: never send the X-Client-Data identifier

---
 .../variations/net/variations_http_headers.cc   | 17 +++++++----------
 1 file changed, 7 insertions(+), 10 deletions(-)

diff --git a/components/variations/net/variations_http_headers.cc b/components/variations/net/variations_http_headers.cc
index 5d35d51f56c64..0a3c8abe23539 100644
--- a/components/variations/net/variations_http_headers.cc
+++ b/components/variations/net/variations_http_headers.cc
@@ -124,16 +124,13 @@ URLValidationResult GetUrlValidationResult(const GURL& url) {
 // rather than `headers`, to be exempted from CORS checks, and to avoid exposing
 // the header to service workers.
 bool ShouldAppendVariationsHeader(const GURL& url, InIncognito incognito) {
-  // Note the criteria for attaching client experiment headers:
-  // 1. We only transmit to Google owned domains which can evaluate
-  // experiments.
-  //    1a. These include hosts which have a standard postfix such as:
-  //         *.doubleclick.net or *.googlesyndication.com or
-  //         exactly www.googleadservices.com or
-  //         international TLD domains *.google.<TLD> or *.youtube.<TLD>.
-  // 2. Only transmit for non-Incognito profiles.
-  return incognito == InIncognito::kNo &&
-         GetUrlValidationResult(url) == URLValidationResult::kShouldAppend;
+  // browse patch 003: never attach the X-Client-Data header. Upstream sends
+  // it to Google-owned domains to correlate the client with its field-trial
+  // (variations) state; browse ships no variations seed and phones nothing
+  // home, so this identifier serves no purpose here. Every AppendVariations*
+  // path funnels through this predicate, so a single false suppresses the
+  // header everywhere without touching the callers.
+  return false;
 }
 
 // Returns non-empty `std::string` if `variations_headers` has a header value
