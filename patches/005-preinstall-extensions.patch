From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Batman <batman@Batman.local>
Date: Sun, 16 Aug 2026 05:59:36 +0200
Subject: [PATCH] browse patch 005: bundle-relative external extensions dir
 (mac)

---
 chrome/common/chrome_paths.cc       | 15 +++++++++------
 extensions/common/feature_switch.cc |  8 +++++++-
 2 files changed, 16 insertions(+), 7 deletions(-)

diff --git a/chrome/common/chrome_paths.cc b/chrome/common/chrome_paths.cc
index 56ff14c59c12a..812281b8c3e23 100644
--- a/chrome/common/chrome_paths.cc
+++ b/chrome/common/chrome_paths.cc
@@ -429,12 +429,15 @@ bool PathProvider(int key, base::FilePath* result) {
 #endif
     case chrome::DIR_EXTERNAL_EXTENSIONS:
 #if BUILDFLAG(IS_MAC)
-      if (!chrome::GetGlobalApplicationSupportDirectory(&cur)) {
-        return false;
-      }
-
-      cur = cur.Append(FILE_PATH_LITERAL("Google"))
-                .Append(FILE_PATH_LITERAL("Chrome"))
+      // browse patch 005: ship preinstalled extensions (uBlock Origin) inside
+      // the app bundle instead of the system-wide "Google/Chrome/External
+      // Extensions" directory. This keeps a fresh browse install ad-blocking
+      // out of the box, needs no installer to touch system paths, and lets a
+      // per-user override in Application Support still take precedence for the
+      // curious. Mirrors the bundle-relative behavior on the other platforms.
+      cur = base::apple::OuterBundlePath()
+                .Append(FILE_PATH_LITERAL("Contents"))
+                .Append(FILE_PATH_LITERAL("Resources"))
                 .Append(FILE_PATH_LITERAL("External Extensions"));
 #else
       if (!base::PathService::Get(base::DIR_MODULE, &cur)) {
diff --git a/extensions/common/feature_switch.cc b/extensions/common/feature_switch.cc
index 988dbc240e3ce..352a6be3885cc 100644
--- a/extensions/common/feature_switch.cc
+++ b/extensions/common/feature_switch.cc
@@ -20,7 +20,13 @@ class CommonSwitches {
       :  // Intentionally no flag since turning this off outside of tests
          // is a security risk.
         prompt_for_external_extensions(nullptr,
-#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
+// browse patch 005: on macOS the external-extensions dir is inside the app
+// bundle (see chrome_paths.cc) — only whoever can already modify the app can
+// write there, and code signing detects any tampering. Upstream's rationale
+// for prompting (third-party software sideloading via a shared system dir)
+// therefore no longer applies; bundled extensions like uBlock Origin should
+// be active out of the box. Windows keeps the upstream prompt.
+#if BUILDFLAG(IS_WIN)
                                        FeatureSwitch::DEFAULT_ENABLED),
 #else
                                        FeatureSwitch::DEFAULT_DISABLED),
