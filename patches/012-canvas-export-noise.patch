 }
 
+void ImageDataBuffer::ApplyOriginNoise(const SecurityOrigin* origin) {
+  if (!is_valid_ || !retained_image_) {
+    return;
+  }
+  // `pixmap_` may alias `retained_image_`'s own pixel memory (the
+  // peekPixels() fast path in the constructor) rather than a copy this
+  // instance exclusively owns — GetSwSkImage() can return a cached image
+  // the canvas keeps using after this encode, so mutating it in place
+  // would corrupt whatever else still references it.
+  // MakePrivateCanvasSnapshotAndApplyNoise() takes a private copy first.
+  MakePrivateCanvasSnapshotAndApplyNoise(retained_image_, pixmap_, origin);
+}
