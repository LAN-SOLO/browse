diff --git a/third_party/blink/renderer/platform/graphics/canvas_noise.cc b/third_party/blink/renderer/platform/graphics/canvas_noise.cc
new file mode 100644
index 0000000000000..a322b6bfb81ea
--- /dev/null
+++ b/third_party/blink/renderer/platform/graphics/canvas_noise.cc
@@ -0,0 +1,146 @@
+// browse patch 011/012: canvas readback noise (Brave/Mullvad "farbling").
+//
+// getImageData() and toDataURL()/toBlob() are the classic canvas-
+// fingerprinting readouts: draw a deterministic scene, read the pixels
+// back (directly, or via a re-decoded PNG), hash them. Because rendering
+// is bit-identical across machines with the same GPU/font stack, that hash
+// is a stable cross-site tracking id. The fix isn't to block these APIs
+// (too much legitimate content relies on them) but to make their output
+// *origin-dependent*: perturb a small, origin-stable subset of pixels by
+// ±1 on one color channel. Invisible to a human, but it flips bits a naive
+// fingerprint hash reads, and it can't be used to correlate the same user
+// across two different sites, since each origin gets an unrelated pattern.
+//
+// Determinism is required in both directions: the SAME origin must get the
+// SAME pattern on every read (repeated reads from one page — a very normal
+// thing to do — must stay internally consistent, and a process-stable
+// pattern can't be "voted out" by reading twice and diffing). Different
+// origins must get UNRELATED patterns (otherwise the noise itself becomes
+// a new stable fingerprint). Restarting the browser must change every
+// site's pattern (otherwise the noise becomes a long-lived tracking id in
+// its own right). A per-process random salt mixed with the origin via
+// base::Hash satisfies all three: stable for the life of the process,
+// different per origin, gone on restart.
+//
+// Deliberately NOT cryptographic — nothing here is a secret, the property
+// we need is "differs across sites, stable within one", not
+// unguessability.
+
+#include "third_party/blink/renderer/platform/graphics/canvas_noise.h"
+
+#include <algorithm>
+#include <cstdint>
+
+#include "base/containers/span.h"
+#include "base/hash/hash.h"
+#include "base/rand_util.h"
+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "ui/gfx/skia_span_util.h"
+
+namespace blink {
+
+namespace {
+
+uint64_t CanvasNoiseProcessSalt() {
+  static const uint64_t salt = base::RandUint64();
+  return salt;
+}
+
+// xorshift-family splitmix64 step. Minimal, fast, good-enough distribution
+// for a non-cryptographic per-pixel decision; avoids fighting
+// base::InsecureRandomGenerator's test-only reseed API for what is, in the
+// end, just "which pixels get nudged".
+uint64_t NextCanvasNoiseValue(uint64_t& state) {
+  uint64_t z = (state += UINT64_C(0x9E3779B97F4A7C15));
+  z = (z ^ (z >> 30)) * UINT64_C(0xBF58476D1CE4E5B9);
+  z = (z ^ (z >> 27)) * UINT64_C(0x94D049BB133111EB);
+  return z ^ (z >> 31);
+}
+
+}  // namespace
+
+void ApplyCanvasReadbackNoise(const SkPixmap& pixmap,
+                              const SecurityOrigin* origin) {
+  if (!origin) {
+    return;
+  }
+  const int width = pixmap.width();
+  const int height = pixmap.height();
+  if (width <= 0 || height <= 0) {
+    return;
+  }
+  // RGBA8/BGRA8 only (both are 4 bytes/pixel, channel order doesn't matter
+  // since we perturb whichever byte `channel` happens to name). Wide-gamut
+  // (F16) canvases use a different byte layout this loop doesn't account
+  // for — skip rather than risk corrupting pixels we haven't verified.
+  if (pixmap.info().bytesPerPixel() != 4) {
+    return;
+  }
+
+  uint64_t state =
+      CanvasNoiseProcessSalt() ^ base::Hash(origin->ToString().Utf8());
+  if (state == 0) {
+    state = UINT64_C(0x9E3779B97F4A7C15);  // splitmix64 needs a nonzero seed.
+  }
+
+  // Chromium's -Wunsafe-buffer-usage forbids raw pointer arithmetic on the
+  // backing bytes; gfx::SkPixmapToWritableSpan is the standard way callers
+  // elsewhere in Blink (e.g. ImageDataBuffer itself) turn a pixmap into a
+  // bounds-checked base::span instead.
+  base::span<uint8_t> bytes = gfx::SkPixmapToWritableSpan(pixmap);
+  const size_t row_bytes = pixmap.rowBytes();
+  const size_t needed =
+      row_bytes * static_cast<size_t>(height - 1) + static_cast<size_t>(width) * 4;
+  if (bytes.size() < needed) {
+    return;  // Unexpected layout (e.g. size computation overflow) — bail.
+  }
+
+  for (int y = 0; y < height; ++y) {
+    base::span<uint8_t> row =
+        bytes.subspan(static_cast<size_t>(y) * row_bytes,
+                      static_cast<size_t>(width) * 4);
+    for (int x = 0; x < width; ++x) {
+      const uint64_t r = NextCanvasNoiseValue(state);
+      if ((r & 0x7) != 0) {
+        continue;  // perturb roughly 1 in 8 pixels
+      }
+      const int channel = static_cast<int>((r >> 3) & 0x3);
+      if (channel == 3) {
+        continue;  // never touch alpha — avoids visible transparency shifts
+      }
+      const int delta = ((r >> 5) & 0x1) ? 1 : -1;
+      const size_t idx = static_cast<size_t>(x) * 4 + static_cast<size_t>(channel);
+      row[idx] = static_cast<uint8_t>(
+          std::clamp(static_cast<int>(row[idx]) + delta, 0, 255));
+    }
+  }
+}
+
+void MakePrivateCanvasSnapshotAndApplyNoise(sk_sp<SkImage>& image,
+                                            SkPixmap& pixmap,
+                                            const SecurityOrigin* origin) {
+  if (!origin || !image) {
+    return;
+  }
+  const SkImageInfo info = pixmap.info();
+  const size_t row_bytes = info.minRowBytes();
+  const size_t size = info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(size)) {
+    return;
+  }
+  sk_sp<SkData> data = SkData::MakeUninitialized(size);
+  SkPixmap owned_pixmap(info, data->writable_data(), row_bytes);
+  if (!image->readPixels(owned_pixmap.info(), owned_pixmap.writable_addr(),
+                         row_bytes, 0, 0)) {
+    return;
+  }
+  image = SkImages::RasterFromData(info, data, row_bytes);
+  pixmap = owned_pixmap;
+
+  ApplyCanvasReadbackNoise(pixmap, origin);
+}
+
+}  // namespace blink
diff --git a/third_party/blink/renderer/platform/graphics/canvas_noise.h b/third_party/blink/renderer/platform/graphics/canvas_noise.h
new file mode 100644
