--- /dev/null
+++ b/third_party/blink/renderer/platform/graphics/canvas_noise.h
@@ -0,0 +1,52 @@
+// browse patch 011/012: shared canvas-fingerprinting noise ("farbling").
+//
+// Perturbs a small, origin-stable subset of a pixel buffer so that reading
+// canvas pixels back (via getImageData, toDataURL, or toBlob) yields a
+// result that differs across origins but stays internally consistent for
+// one origin during a browser session. See canvas_noise.cc for the full
+// rationale; used from both
+// third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
+// (getImageData, patch 011) and
+// third_party/blink/renderer/platform/graphics/image_data_buffer.cc
+// (toDataURL/toBlob, patch 012) — one algorithm, one place to review.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_CANVAS_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_CANVAS_NOISE_H_
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "third_party/skia/include/core/SkRefCnt.h"
+
+class SkImage;
+
+namespace blink {
+
+class SecurityOrigin;
+
+// `pixmap` must be a buffer this caller exclusively owns (not aliasing a
+// cached or shared image) — this function mutates it in place. Only RGBA8/
+// BGRA8 (4 bytes/pixel) pixmaps are perturbed; other layouts are left
+// untouched. `origin` may be null, in which case this is a no-op.
+PLATFORM_EXPORT void ApplyCanvasReadbackNoise(const SkPixmap& pixmap,
+                                              const SecurityOrigin* origin);
+
+// Canvas readouts (toDataURL/toBlob, getImageData's non-accelerated fast
+// path) often reach this code via SkImage::peekPixels() — a zero-copy view
+// into memory the image still owns, possibly shared with the canvas's own
+// compositing output or cached elsewhere. Calling ApplyCanvasReadbackNoise
+// directly on such a pixmap would corrupt whatever else references it. This
+// helper reads `pixmap`'s current contents into a fresh, exclusively-owned
+// buffer via `image->readPixels()` first (same technique
+// ImageDataBuffer's constructor already uses for its texture-backed
+// branch), repoints both `image` and `pixmap` at that buffer, and only then
+// applies the noise. Safe to call unconditionally, including when `pixmap`
+// already happens to be private — the extra copy is never wasted since
+// every caller is about to encode this one snapshot and discard it.
+PLATFORM_EXPORT void MakePrivateCanvasSnapshotAndApplyNoise(
+    sk_sp<SkImage>& image,
+    SkPixmap& pixmap,
+    const SecurityOrigin* origin);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_CANVAS_NOISE_H_
