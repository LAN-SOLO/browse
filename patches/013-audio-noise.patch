+// browse patch 011/012/013: shared fingerprinting noise ("farbling") for
+// canvas AND Web Audio readouts.
 //
-// Perturbs a small, origin-stable subset of a pixel buffer so that reading
-// canvas pixels back (via getImageData, toDataURL, or toBlob) yields a
-// result that differs across origins but stays internally consistent for
-// one origin during a browser session. See canvas_noise.cc for the full
-// rationale; used from both
+// Perturbs a small, origin-stable subset of a pixel or audio-sample buffer
+// so that reading canvas pixels back (via getImageData, toDataURL, or
+// toBlob) or audio samples back (via AudioBuffer.getChannelData /
+// copyFromChannel) yields a result that differs across origins but stays
+// internally consistent for one origin during a browser session. See
+// canvas_noise.cc for the full rationale; used from
 // third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
-// (getImageData, patch 011) and
+// (getImageData, patch 011),
 // third_party/blink/renderer/platform/graphics/image_data_buffer.cc
-// (toDataURL/toBlob, patch 012) — one algorithm, one place to review.
+// (toDataURL/toBlob, patch 012), and
+// third_party/blink/renderer/modules/webaudio/audio_buffer.cc
+// (getChannelData/copyFromChannel, patch 013) — one algorithm family, one
+// place to review. Kept in graphics/ rather than split into a
+// differently-located file: it shares the same PRNG/salt primitives and
+// none of the three callers are far from an existing platform/graphics
+// dependency.
 
 #ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_CANVAS_NOISE_H_
 #define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_CANVAS_NOISE_H_
 
+#include "base/containers/span.h"
 #include "third_party/blink/renderer/platform/platform_export.h"
 #include "third_party/skia/include/core/SkPixmap.h"
 #include "third_party/skia/include/core/SkRefCnt.h"
@@ -47,6 +56,23 @@ PLATFORM_EXPORT void MakePrivateCanvasSnapshotAndApplyNoise(
     SkPixmap& pixmap,
     const SecurityOrigin* origin);
 
+// `samples` must be a buffer this caller may freely mutate — unlike canvas
+// pixels, Web Audio's getChannelData() intentionally returns a live,
+// writable view onto the AudioBuffer's own storage (mutating it is
+// spec'd, legitimate behavior), so unlike ApplyCanvasReadbackNoise there
+// is no "might alias a cache" concern to guard against here; callers are
+// instead responsible for applying this at most once per channel (see
+// AudioBuffer::EnsureChannelNoised) so repeated reads stay consistent and
+// noise doesn't accumulate call after call. `channel_index` is folded into
+// the seed so different channels of the same buffer don't all shift by an
+// identical pattern. The perturbation magnitude is far below both 16-bit
+// PCM quantization noise and any plausible audibility threshold — this
+// changes what a fingerprint script reads, never what anything sounds
+// like. `origin` may be null, in which case this is a no-op.
+PLATFORM_EXPORT void ApplyAudioReadbackNoise(base::span<float> samples,
+                                             unsigned channel_index,
+                                             const SecurityOrigin* origin);
+
 }  // namespace blink
 
 #endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_CANVAS_NOISE_H_
