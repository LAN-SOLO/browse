 #include "third_party/blink/renderer/platform/wtf/text/strcat.h"
 
 namespace blink {
@@ -201,7 +204,29 @@ AudioBuffer::AudioBuffer(AudioBus* bus)
   }
 }
 
+void AudioBuffer::EnsureChannelNoised(unsigned channel_index,
+                                      const SecurityOrigin* origin) {
+  if (!origin || channel_index >= channels_.size()) {
+    return;
+  }
+  // Lazily sized instead of at construction time: this class has several
+  // constructors (from raw channel counts, from an AudioBus, from
+  // options), and growing on demand here means none of them need to know
+  // about noise bookkeeping. WTF::Vector value-initializes new bool
+  // entries to false.
+  if (channel_noise_applied_.size() <= channel_index) {
+    channel_noise_applied_.resize(channels_.size());
+  }
+  if (channel_noise_applied_[channel_index]) {
+    return;
+  }
+  channel_noise_applied_[channel_index] = true;
+  ApplyAudioReadbackNoise(channels_[channel_index]->AsSpan(), channel_index,
+                          origin);
+}
+
 NotShared<DOMFloat32Array> AudioBuffer::getChannelData(
+    ScriptState* script_state,
     unsigned channel_index,
     ExceptionState& exception_state) {
   if (channel_index >= channels_.size()) {
@@ -213,6 +238,15 @@ NotShared<DOMFloat32Array> AudioBuffer::getChannelData(
     return NotShared<DOMFloat32Array>(nullptr);
   }
 
+  // browse patch 013: origin-dependent noise on first JS-visible read of
+  // this channel — see EnsureChannelNoised(). script_state may be missing
+  // its context during worker/window teardown; skip noising rather than
+  // crash, same as every other null-origin guard in this patch series.
+  if (ExecutionContext* execution_context =
+          script_state ? ExecutionContext::From(script_state) : nullptr) {
+    EnsureChannelNoised(channel_index, execution_context->GetSecurityOrigin());
+  }
+
   return getChannelData(channel_index);
 }
 
@@ -224,13 +258,16 @@ NotShared<DOMFloat32Array> AudioBuffer::getChannelData(unsigned channel_index) {
   return NotShared<DOMFloat32Array>(channels_[channel_index].Get());
 }
 
-void AudioBuffer::copyFromChannel(NotShared<DOMFloat32Array> destination,
+void AudioBuffer::copyFromChannel(ScriptState* script_state,
+                                  NotShared<DOMFloat32Array> destination,
                                   int32_t channel_number,
                                   ExceptionState& exception_state) {
-  return copyFromChannel(destination, channel_number, 0, exception_state);
+  return copyFromChannel(script_state, destination, channel_number, 0,
+                         exception_state);
 }
 
-void AudioBuffer::copyFromChannel(NotShared<DOMFloat32Array> destination,
+void AudioBuffer::copyFromChannel(ScriptState* script_state,
+                                  NotShared<DOMFloat32Array> destination,
                                   int32_t channel_number,
                                   size_t buffer_offset,
                                   ExceptionState& exception_state) {
@@ -251,6 +288,17 @@ void AudioBuffer::copyFromChannel(NotShared<DOMFloat32Array> destination,
     return;
   }
 
+  // browse patch 013: same origin-dependent noise as getChannelData() —
+  // copyFromChannel() reads the same live channel storage via a separate
+  // path (it doesn't call getChannelData() internally), so it needs its
+  // own call to reach channels an origin has only ever copied, never
+  // fetched directly.
+  if (ExecutionContext* execution_context =
+          script_state ? ExecutionContext::From(script_state) : nullptr) {
+    EnsureChannelNoised(static_cast<unsigned>(channel_number),
+                        execution_context->GetSecurityOrigin());
+  }
+
   base::span<const float> src = channels_[channel_number].Get()->AsSpan();
   base::span<float> dst = destination->AsSpan();
 
