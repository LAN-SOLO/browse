diff --git a/third_party/blink/renderer/platform/graphics/canvas_noise.cc b/third_party/blink/renderer/platform/graphics/canvas_noise.cc
index a322b6bfb81ea..5b7234681a941 100644
--- a/third_party/blink/renderer/platform/graphics/canvas_noise.cc
+++ b/third_party/blink/renderer/platform/graphics/canvas_noise.cc
@@ -143,4 +143,33 @@ void MakePrivateCanvasSnapshotAndApplyNoise(sk_sp<SkImage>& image,
   ApplyCanvasReadbackNoise(pixmap, origin);
 }
 
+void ApplyAudioReadbackNoise(base::span<float> samples,
+                             unsigned channel_index,
+                             const SecurityOrigin* origin) {
+  if (!origin || samples.empty()) {
+    return;
+  }
+  uint64_t state =
+      CanvasNoiseProcessSalt() ^ base::Hash(origin->ToString().Utf8()) ^
+      (static_cast<uint64_t>(channel_index) * UINT64_C(0x9E3779B97F4A7C15));
+  if (state == 0) {
+    state = UINT64_C(0x9E3779B97F4A7C15);  // splitmix64 needs a nonzero seed.
+  }
+
+  // 2e-7 is roughly an order of magnitude below 16-bit PCM's quantization
+  // floor (~3e-5) and far below any threshold of human audibility —
+  // plenty to change the exact bytes a fingerprint script hashes, nowhere
+  // near enough to be heard or to matter to any real audio processing.
+  constexpr float kMaxDelta = 2e-7f;
+  for (float& sample : samples) {
+    const uint64_t r = NextCanvasNoiseValue(state);
+    if ((r & 0x7) != 0) {
+      continue;  // perturb roughly 1 in 8 samples, same density as canvas
+    }
+    // Top 24 bits of `r` as a uniform value in [0, 1).
+    const float unit = static_cast<float>(r >> 40) / static_cast<float>(1u << 24);
+    sample += (unit * 2.0f - 1.0f) * kMaxDelta;
+  }
+}
+
 }  // namespace blink
diff --git a/third_party/blink/renderer/platform/graphics/canvas_noise.h b/third_party/blink/renderer/platform/graphics/canvas_noise.h
index e7c01d49a59a0..851b37b9f5afb 100644
