+class SecurityOrigin;
 class SharedAudioBuffer;
 
 class MODULES_EXPORT AudioBuffer final : public ScriptWrappable {
@@ -89,13 +91,16 @@ class MODULES_EXPORT AudioBuffer final : public ScriptWrappable {
 
   // Channel data access
   unsigned numberOfChannels() const { return channels_.size(); }
-  NotShared<DOMFloat32Array> getChannelData(unsigned channel_index,
+  NotShared<DOMFloat32Array> getChannelData(ScriptState*,
+                                            unsigned channel_index,
                                             ExceptionState&);
   NotShared<DOMFloat32Array> getChannelData(unsigned channel_index);
-  void copyFromChannel(NotShared<DOMFloat32Array>,
+  void copyFromChannel(ScriptState*,
+                       NotShared<DOMFloat32Array>,
                        int32_t channel_number,
                        ExceptionState&);
-  void copyFromChannel(NotShared<DOMFloat32Array>,
+  void copyFromChannel(ScriptState*,
+                       NotShared<DOMFloat32Array>,
                        int32_t channel_number,
                        size_t buffer_offset,
                        ExceptionState&);
@@ -119,8 +124,18 @@ class MODULES_EXPORT AudioBuffer final : public ScriptWrappable {
  private:
   bool CreatedSuccessfully(unsigned desired_number_of_channels) const;
 
+  // browse patch 013: perturbs channel `channel_index`'s live sample data
+  // once (never again for the same channel — see canvas_noise.h's
+  // ApplyAudioReadbackNoise for the full rationale) so that reading it
+  // back via getChannelData()/copyFromChannel() is origin-dependent
+  // rather than a stable cross-site audio fingerprint. Safe to call
+  // unconditionally; a no-op past the first call per channel or if
+  // `origin` is null.
+  void EnsureChannelNoised(unsigned channel_index, const SecurityOrigin*);
+
   float sample_rate_;
   uint32_t length_;
+  Vector<bool> channel_noise_applied_;
 
   HeapVector<Member<DOMFloat32Array>> channels_;
 };
